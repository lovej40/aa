    eq.series = eq.series.slice(1).concat([next]);
    eq.metricValue = next;

    var card = document.querySelector('.eq-card[data-id="'+eq.id+'"]');
    if(card){
      var metricEl = card.querySelector('[data-metric]');
      if(metricEl) metricEl.innerHTML = eq.metricValue + ' <small>' + escapeHtml(eq.metricUnit) + '</small>';
      var sparkEl = card.querySelector('[data-spark]');
      if(sparkEl) sparkEl.innerHTML = sparkSvg(eq.series, eq.status);
    }
  }

  renderFleet();
  renderAlerts();
  renderLog();
  initTierHighlight();

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduceMotion){
    window.setInterval(tickLive, 3800);
  }
})();
</script>

