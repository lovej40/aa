  function matchesKeyword(p, kw){
    if(!kw) return false;
    var hay = [p.name].concat(p.keywords || []).concat(p.equipmentTags || []).join(' ').toLowerCase();
    var parts = kw.split(/[\s,]+/).filter(Boolean);
    return parts.some(function(part){ return hay.indexOf(part) !== -1; });
  }

  function isEligible(p, f){
    if(p.bizRequired && f.bizRegistered === '없음') return false;
    if(f.age < p.ageMin - 5 || f.age > p.ageMax + 5) return false;
    if(p.genderCondition && f.gender !== '선택안함' && f.gender !== p.genderCondition) return false;
    return true;
  }

  function computeScore(p, f){
    var factors = { age:0, region:0, status:0, biz:0, purpose:0, income:0, deadline:0, other:5 };

    factors.age = (f.age >= p.ageMin && f.age <= p.ageMax) ? 15 : 6;
    factors.region = (p.regions.indexOf('전국') !== -1 || p.regions.indexOf(f.region) !== -1) ? 15 : 0;
    factors.status = (p.targetStatus.indexOf(f.status) !== -1) ? 15 : 4;

    if(p.bizRequired){
      if(f.bizRegistered === '있음' || f.bizRegistered === '예정'){
        if(p.bizAgeMin != null && f.bizAge != null){
          factors.biz = (f.bizAge >= p.bizAgeMin && (p.bizAgeMax == null || f.bizAge <= p.bizAgeMax)) ? 15 : 7;
        } else { factors.biz = 15; }
      } else { factors.biz = 0; }
    } else { factors.biz = 12; }

    if(f.purposes.length === 0){ factors.purpose = 13; }
    else { factors.purpose = (f.purposes.indexOf(p.category) !== -1) ? 15 : 4; }

    if(p.incomeSensitive){
      if(f.income === '낮음' || f.income === '모름') factors.income = 10;
      else if(f.income === '중간') factors.income = 6;
      else factors.income = 2;
    } else { factors.income = 8; }

    if(p.deadline){
      var days = Math.round((new Date(p.deadline + 'T00:00:00') - new Date()) / 86400000);
      if(days < 0) factors.deadline = 1;
      else if(days <= 30) factors.deadline = 10;
      else factors.deadline = 6;
    } else { factors.deadline = 8; }

    if(f.keyword){
      factors.other = matchesKeyword(p, f.keyword) ? 5 : -10;
    }

    var total = factors.age + factors.region + factors.status + factors.biz + factors.purpose + factors.income + factors.deadline + factors.other;
    total = Math.max(0, Math.min(100, total));
    return {total: total, factors: factors};
  }

  function reasonLine(p, f, factors){
    var bits = [];
    if(factors.age >= 15) bits.push('연령');
    if(factors.region >= 15) bits.push('지역');
    if(factors.status >= 15) bits.push('현재 상태(' + STATUS_LABEL[f.status] + ')');
    if(factors.biz >= 15) bits.push('사업자·업력');
    if(factors.purpose >= 15) bits.push('희망 분야');
    if(bits.length === 0) return '일부 조건만 일치합니다 — 세부 자격은 공고문에서 확인하세요.';
    return '<b>' + bits.join(' · ') + '</b>이(가) 이 사업의 대상 조건과 일치합니다.';
  }

  function tierOf(score){
    if(score >= 90) return {cls:'tier-strong', label:'강력추천', ring:'var(--signal)'};
    if(score >= 75) return {cls:'tier-good', label:'추천', ring:'var(--signal)'};
    if(score >= 60) return {cls:'tier-mid', label:'조건 확인', ring:'var(--warn)'};
    return {cls:'', label:'참고', ring:'var(--muted)'};
  }

  function fmtDeadline(iso){
    if(!iso) return {text:'상시 접수', soon:false};
    var d = new Date(iso + 'T00:00:00');
    var today = new Date(); today.setHours(0,0,0,0);
    var diff = Math.round((d - today) / 86400000);
    var label = iso.replace(/-/g,'.');
    if(diff < 0) return {text:'~' + label + ' (마감)', soon:false};
    if(diff <= 21) return {text:'D-' + diff + ' · ~' + label, soon:true};
    return {text:'~' + label, soon:false};
  }

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

