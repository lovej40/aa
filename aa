<style>
  :root{
    --bg:#FFFFFF; --bg-panel:#FFFFFF; --bg-raised:#F0F8FF;
    --border:#DDDDDD; --grid:#ECECEC;
    --signal:#2F6DF6; --signal-dim:#003994; --signal-soft:rgba(47,109,246,0.12);
    --text:#303030; --text-dim:#374151; --text-faint:#767676;
    --font-family:"Noto Sans KR","Nanum Gothic",sans-serif,arial;
    --radius-md:9px; --radius-lg:12px;
    --shadow-card:0 5px 5px rgba(0,0,0,.15);
    --shadow-strong:0 4px 4px rgba(0,0,0,.25);
    color-scheme:light;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-family);line-height:1.6;-webkit-font-smoothing:antialiased;}
  h1,h2{font-weight:700;text-wrap:balance;margin:0;letter-spacing:-0.01em;}
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1000px;margin:0 auto;padding:0 28px;}
  header.nav{border-bottom:1px solid var(--border);box-shadow:0 7px 10px rgba(0,0,0,.05);}
  .brand{display:flex;align-items:center;gap:10px;padding:22px 28px;font-weight:700;max-width:1000px;margin:0 auto;}
  .brand-mark{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--signal);position:relative;flex-shrink:0;}
  .brand-mark::before{content:"";position:absolute;inset:6px;border-radius:50%;border:1px solid var(--signal-dim);}
  .brand-mark::after{content:"";position:absolute;top:3px;left:3px;width:3px;height:3px;border-radius:50%;background:var(--signal);box-shadow:0 0 6px 1px var(--signal);}
  .eyebrow{font-size:0.76rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--signal);display:flex;align-items:center;gap:0.6em;}
  .eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--signal);box-shadow:0 0 8px 1px var(--signal);}
  .hero{padding:40px 0 44px;border-bottom:1px solid var(--border);}
  .hero h1{font-size:clamp(1.7rem,3.4vw,2.5rem);margin:16px 0 12px;max-width:20ch;}
  .hero p{color:var(--text-dim);max-width:60ch;font-size:1rem;}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:40px 0;}
  .card{border:1px solid var(--border);background:var(--bg-panel);border-radius:var(--radius-md);box-shadow:var(--shadow-card);padding:26px 22px;display:flex;flex-direction:column;gap:12px;transition:box-shadow .2s,border-color .2s,transform .2s;}
  .card:hover{border-color:var(--signal-dim);box-shadow:var(--shadow-strong);transform:translateY(-2px);}
  .card .step{font-size:0.72rem;font-weight:700;color:var(--signal);}
  .card h2{font-size:1.15rem;}
  .card p{color:var(--text-dim);font-size:0.88rem;flex:1;}
  .card .go{font-size:0.8rem;font-weight:700;color:var(--signal);}
  footer{border-top:1px solid var(--border);padding:24px 0;font-size:0.8rem;color:var(--text-faint);}
  @media (max-width:820px){ .grid{grid-template-columns:1fr;} }
</style>
</head>
