<title>IoT 관리 콘솔</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFFFFF;
    --bg-panel:#FFFFFF;
    --bg-raised:#F0F8FF;
    --bg-input:#FFFFFF;
    --grid:#ECECEC;
    --border:#DDDDDD;
    --signal:#2F6DF6;
    --signal-dim:#003994;
    --signal-soft:rgba(47,109,246,0.12);
    --warn:#B45309;
    --warn-soft:rgba(180,83,9,0.12);
    --crit:#E40000;
    --crit-soft:rgba(228,0,0,0.12);
    --muted:#767676;
    --muted-soft:rgba(118,118,118,0.14);
    --text:#303030;
    --text-dim:#374151;
    --text-faint:#767676;
    --font-display:"Noto Sans KR","Nanum Gothic",sans-serif,arial;
    --font-mono:"Noto Sans KR","Nanum Gothic",sans-serif,arial;
    --radius-sm:5px;
    --radius-md:9px;
    --radius-lg:12px;
    --shadow-card:0 5px 5px rgba(0,0,0,.15);
    --shadow-strong:0 4px 4px rgba(0,0,0,.25);
    --shadow-colored:0 3px 8px rgba(0,0,0,.3);
    color-scheme:light;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-display);line-height:1.6;-webkit-font-smoothing:antialiased;}
  h1,h2,h3{font-family:var(--font-display);font-weight:700;text-wrap:balance;margin:0;letter-spacing:-0.01em;}
  p{margin:0;}
  button,select{font-family:inherit;}
  :focus-visible{outline:2px solid var(--signal);outline-offset:2px;}
  .icon{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
  .eyebrow{font-family:var(--font-mono);font-size:0.76rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--signal);display:flex;align-items:center;gap:0.6em;}
  .eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--signal);box-shadow:0 0 8px 1px var(--signal);}
  .wrap{max-width:1280px;margin:0 auto;padding:0 28px;}

  header.nav{position:sticky;top:0;z-index:60;background:rgba(255,255,255,0.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);box-shadow:0 7px 10px rgba(0,0,0,.05);}
  .nav-inner{max-width:1280px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;}
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:1rem;white-space:nowrap;}
  .brand-mark{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--signal);position:relative;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .brand-mark::before{content:"";position:absolute;width:13px;height:13px;border-radius:50%;border:1px solid var(--signal-dim);}
  .brand-mark::after{content:"";width:3px;height:3px;border-radius:50%;background:var(--signal);box-shadow:0 0 6px 1px var(--signal);}
  .brand small{display:block;font-family:var(--font-mono);font-weight:500;font-size:0.68rem;color:var(--text-faint);letter-spacing:0.06em;}
  .nav-actions{display:flex;gap:10px;align-items:center;}
  .btn{font-weight:600;font-size:0.86rem;padding:9px 18px;border-radius:var(--radius-md);border:1px solid transparent;cursor:pointer;display:inline-flex;align-items:center;gap:7px;text-decoration:none;white-space:nowrap;transition:transform .2s,box-shadow .2s,background .2s,border-color .2s;background:none;}
  .btn-ghost{border-color:var(--border);color:var(--text);}
  .btn-ghost:hover{border-color:var(--signal-dim);color:var(--signal);}
  .btn-primary{background:var(--signal);color:#FFFFFF;}
  .btn-primary:hover{box-shadow:0 0 0 3px var(--signal-soft);transform:translateY(-1px);}
  .btn-small{padding:7px 14px;font-size:0.78rem;}

  .intro{padding:40px 0 30px;border-bottom:1px solid var(--border);}
  .intro h1{font-size:clamp(1.5rem,2.6vw,2.05rem);margin:14px 0 10px;max-width:34ch;}
  .intro p{color:var(--text-dim);max-width:62ch;font-size:0.96rem;}

  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius-md);overflow:hidden;margin-top:26px;}
  .stat-cell{background:var(--bg-panel);padding:18px 20px;}
  .stat-cell .n{font-family:var(--font-mono);font-size:1.6rem;font-weight:600;color:var(--signal);font-variant-numeric:tabular-nums;}
  .stat-cell.warn .n{color:var(--warn);}
  .stat-cell.crit .n{color:var(--crit);}
  .stat-cell .l{font-size:0.78rem;color:var(--text-faint);margin-top:4px;}

  section{padding:44px 0;border-bottom:1px solid var(--border);}
  .section-head{max-width:680px;margin-bottom:26px;}
  .section-head h2{font-size:1.3rem;margin:10px 0 8px;}
  .section-head p{color:var(--text-dim);font-size:0.9rem;}

  .tier-table{width:100%;border-collapse:collapse;font-size:0.86rem;}
  .tier-table th{text-align:left;font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--text-faint);padding:10px 14px;border-bottom:1px solid var(--border);}
  .tier-table td{padding:14px;border-bottom:1px solid var(--border);color:var(--text-dim);vertical-align:top;}
  .tier-table tr.me{background:var(--signal-soft);}
  .tier-table tr.me td{color:var(--text);}
  .tier-badge{font-family:var(--font-mono);font-size:0.72rem;color:var(--signal);border:1px solid var(--signal-dim);border-radius:var(--radius-sm);padding:2px 7px;display:inline-block;}
  .tier-table .you{font-family:var(--font-mono);font-size:0.7rem;color:var(--signal);}
  .tier-picker{display:flex;align-items:center;gap:10px;margin-bottom:18px;font-size:0.85rem;color:var(--text-dim);flex-wrap:wrap;}
  .tier-picker select{background:var(--bg-input);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:var(--radius-sm);font-size:0.85rem;}
  .table-scroll{overflow-x:auto;}

  .fleet-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}
  .eq-card{border:1px solid var(--border);background:var(--bg-panel);border-radius:var(--radius-md);box-shadow:var(--shadow-card);overflow:hidden;transition:border-color .2s,box-shadow .2s;}
  .eq-card:hover{border-color:var(--signal-dim);box-shadow:var(--shadow-strong);}
  .eq-main{padding:18px 20px;cursor:pointer;}
  .eq-top{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;}
  .status-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .status-dot.ok{background:var(--signal);box-shadow:0 0 6px 1px var(--signal);}
  .status-dot.check{background:var(--warn);box-shadow:0 0 6px 1px var(--warn);}
  .status-dot.crit{background:var(--crit);box-shadow:0 0 6px 1px var(--crit);}
  .status-text{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-dim);}
  .status-text.ok{color:var(--signal);}
  .status-text.check{color:var(--warn);}
  .status-text.crit{color:var(--crit);}
  .eq-prog{margin-left:auto;font-family:var(--font-mono);font-size:0.68rem;color:var(--text-faint);}
  .eq-card h3{font-size:1rem;margin-bottom:4px;}
  .eq-type{font-size:0.78rem;color:var(--text-faint);margin-bottom:12px;}
  .eq-metric-row{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px;}
  .eq-metric .v{font-family:var(--font-mono);font-size:1.15rem;color:var(--text);font-variant-numeric:tabular-nums;}
  .eq-metric .v small{font-size:0.68rem;color:var(--text-faint);font-weight:400;}
  .eq-metric .l{font-size:0.7rem;color:var(--text-faint);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.04em;}
  .spark{display:block;overflow:visible;}
  .spark path{fill:none;stroke-width:1.6;}
  .spark path.line-ok{stroke:var(--signal);}
  .spark path.line-check{stroke:var(--warn);}
  .spark path.line-crit{stroke:var(--crit);}
  .spark circle{fill:var(--bg-panel);stroke-width:1.6;}
  .util-bar{height:4px;border-radius:2px;background:var(--grid);overflow:hidden;margin-top:2px;}
  .util-fill{height:100%;background:var(--signal);border-radius:2px;}
  .eq-meta{display:flex;justify-content:space-between;font-size:0.74rem;color:var(--text-faint);margin-top:4px;}
  .chev{color:var(--text-faint);float:right;transition:transform .2s;}
  .eq-card.open .chev{transform:rotate(180deg);}

  .eq-detail{display:none;border-top:1px solid var(--border);padding:18px 20px 20px;}
  .eq-card.open .eq-detail{display:block;}
  .eq-detail h4{font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-faint);margin:0 0 10px;}
  .mini-log{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-direction:column;gap:8px;}
  .mini-log li{font-size:0.8rem;color:var(--text-dim);display:flex;gap:8px;align-items:baseline;}
  .mini-log .t{font-family:var(--font-mono);font-size:0.7rem;color:var(--text-faint);white-space:nowrap;}
  .eq-actions{display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;}

  .alert-feed{display:flex;flex-direction:column;gap:2px;}
  .alert-row{display:flex;align-items:flex-start;gap:14px;padding:14px 4px;border-bottom:1px solid var(--border);}
  .alert-row:last-child{border-bottom:none;}
  .alert-sev{width:8px;height:8px;border-radius:50%;margin-top:6px;flex-shrink:0;}
  .alert-sev.ok{background:var(--signal);}
  .alert-sev.check{background:var(--warn);}
  .alert-sev.crit{background:var(--crit);}
  .alert-body{flex:1;}
  .alert-eq{font-size:0.78rem;color:var(--text-faint);}
  .alert-text{font-size:0.88rem;color:var(--text);}
  .alert-time{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-faint);white-space:nowrap;}

  .table-wrap{overflow-x:auto;}
  table.log-table{width:100%;border-collapse:collapse;font-size:0.85rem;min-width:640px;}
  table.log-table th{text-align:left;font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--text-faint);padding:10px 12px;border-bottom:1px solid var(--border);}
  table.log-table td{padding:12px;border-bottom:1px solid var(--border);color:var(--text-dim);}
  .status-pill{font-family:var(--font-mono);font-size:0.7rem;padding:3px 8px;border-radius:2px;background:var(--signal-soft);color:var(--signal);}
  .status-pill.pending{background:var(--warn-soft);color:var(--warn);}

  .disclaimer-bar{display:flex;gap:12px;align-items:flex-start;padding:14px 18px;border:1px solid var(--border);background:var(--bg-raised);border-radius:var(--radius-md);margin-top:26px;font-size:0.8rem;color:var(--text-dim);}
  .disclaimer-bar .icon{color:var(--warn);margin-top:2px;flex-shrink:0;}
  .disclaimer-bar b{color:var(--text);}

  footer{padding:28px 0;}
  .footer-inner{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:0.78rem;color:var(--text-faint);}

  .toast{position:fixed;bottom:24px;right:24px;background:var(--bg-raised);border:1px solid var(--signal-dim);color:var(--text);padding:13px 18px;border-radius:var(--radius-md);font-size:0.85rem;display:flex;align-items:center;gap:10px;transform:translateY(20px);opacity:0;pointer-events:none;transition:transform .25s,opacity .25s;z-index:100;max-width:320px;}
  .toast.show{transform:translateY(0);opacity:1;}
  .toast .dot{width:7px;height:7px;border-radius:50%;background:var(--signal);flex-shrink:0;box-shadow:0 0 6px 1px var(--signal);}
  .live-pill{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:0.7rem;color:var(--signal);}
  .live-pill .d{width:6px;height:6px;border-radius:50%;background:var(--signal);animation:blink 1.6s ease-in-out infinite;}
  @keyframes blink{0%,100%{opacity:1;}50%{opacity:0.25;}}
  @media (prefers-reduced-motion:reduce){.live-pill .d{animation:none;}}

  @media (max-width:860px){
    .stat-row{grid-template-columns:1fr 1fr;}
    .wrap{padding:0 18px;}
  }
</style>

