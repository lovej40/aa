  function render(list, sortMode){
    var scored = list.filter(function(x){ return x.eligible; });

    scored.sort(function(a,b){
      if(sortMode === 'amount') return b.p.amountValue - a.p.amountValue;
      if(sortMode === 'deadline'){
        var da = a.p.deadline ? new Date(a.p.deadline) : new Date('2999-01-01');
        var db = b.p.deadline ? new Date(b.p.deadline) : new Date('2999-01-01');
        return da - db;
      }
      return b.score - a.score;
    });

    var high = scored.filter(function(x){ return x.score >= 40; });
    var low = scored.filter(function(x){ return x.score < 40; });

    $('cardList').innerHTML = high.map(function(x){ return cardHtml(x.p, x.f, x.score, x.factors); }).join('');
    $('lowGroup').innerHTML = low.map(function(x){ return cardHtml(x.p, x.f, x.score, x.factors); }).join('');

    var strongCount = scored.filter(function(x){ return x.score >= 90; }).length;
    var goodCount = scored.filter(function(x){ return x.score >= 75 && x.score < 90; }).length;

    $('resultsCount').innerHTML = '총 <b>' + scored.length + '</b>건 매칭 · 강력추천 <b>' + strongCount + '</b>건 · 추천 <span class="amber">' + goodCount + '</span>건';

    var moreToggle = $('moreToggle');
    if(low.length){
      moreToggle.style.display = 'flex';
      moreToggle.textContent = '적합도 40% 미만 지원사업 ' + low.length + '건 더 보기';
    } else {
      moreToggle.style.display = 'none';
