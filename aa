    }

    $('idleState').classList.toggle('active', scored.length === 0);
    $('cardList').style.display = scored.length ? '' : 'none';
  }

  function runScan(){
    var f = readFilters();
    var results = PROGRAMS.map(function(p){
      var eligible = isEligible(p, f);
      if(!eligible) return {p:p, f:f, eligible:false, score:0, factors:{}};
      var r = computeScore(p, f);
      return {p:p, f:f, eligible:true, score:r.total, factors:r.factors};
    });
    currentResults = results;

    $('scanState').classList.add('active');
    $('idleState').classList.remove('active');
    $('cardList').innerHTML = '';
    $('lowGroup').innerHTML = '';
    $('moreToggle').style.display = 'none';

    window.setTimeout(function(){
