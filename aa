        '</div>' +
        '<div class="detail-block" style="margin-bottom:16px;"><h4>필요 서류</h4><ul>' + docs + '</ul></div>' +
        (equipTagsHtml ? '<div class="detail-block" style="margin-bottom:16px;"><h4>지원 품목·장비</h4>' + equipTagsHtml + '</div>' : '') +
